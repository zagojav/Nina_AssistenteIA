# ---------------------------------------------------------------------------
# Groq — a chave só existe no servidor; nenhuma rota devolve o valor.
# Console: https://console.groq.com/keys
# Modelos: llama-3.1-8b-instant (conversa) e llama-3.3-70b-versatile (análise)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------------
# Firebase Admin (servidor) — Console > Configurações > Contas de serviço
# A chave privada vai numa linha só, com \n escapado.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app

# ---------------------------------------------------------------------------
# Firebase Web (client) — usado só para o login do curador (Firebase Auth).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Instituição atendida por este deploy (uma por deploy).
# Sai no retorno de POST /api/seed.
# ---------------------------------------------------------------------------
INSTITUICAO_ID=

# ---------------------------------------------------------------------------
# Sessão do idoso (cookie assinado). Mínimo 32 caracteres.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Rotinas agendadas (consolidados e retenção).
# ---------------------------------------------------------------------------
CRON_SECRET=

# Provisionamento inicial. Remova depois de rodar o seed.
SEED_SECRET=

# ---------------------------------------------------------------------------
# Envio de relatório por e-mail (opcional; sem isso só resta PDF e WhatsApp).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE="Nina <relatorios@suainstituicao.com.br>"

# ---------------------------------------------------------------------------
# Política de retenção, em dias. Decisão da instituição — reveja com jurídico.
# ---------------------------------------------------------------------------
RETENCAO_CONVERSAS_DIAS=180
RETENCAO_INDICIOS_DIAS=730
RETENCAO_RELATORIOS_DIAS=1825
RETENCAO_LOGS_DIAS=1825
